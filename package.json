{
  "name": "manodx",
  "version": "1.0.1",
  "description": "Websites rendered by the manodx framework",
  "type": "module",
  "license": "MIT",
  "author": "Gabriel Ramos",
  "keywords": [
    "markdown",
    "mdx",
    "static-site",
    "ssg",
    "framework"
  ],
  "homepage": "https://manodx.whosramoss.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosramoss/manodx.git"
  },
  "bugs": {
    "url": "https://github.com/whosramoss/manodx/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "manodx": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0"
  }
}
